# Supabase — powers live reviews. Copy this file to .env.local and fill in the values.
# Find both in the Supabase dashboard: Project Settings -> API.
# The anon (public) key is safe to expose in the client; Row Level Security limits it.
# Leave these blank and reviews fall back to local-only, device-stored behaviour.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
